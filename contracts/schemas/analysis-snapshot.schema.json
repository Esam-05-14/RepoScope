{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reposcope.local/schemas/analysis-snapshot/1.1.0",
  "title": "AnalysisSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "engineVersion",
    "parserVersion",
    "scope",
    "nodes",
    "observations",
    "semanticEdges",
    "coverage",
    "graphDigest",
    "contentManifestDigest"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "description": "Reject unknown major versions. 1.x is this contract."
    },
    "engineVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "parserVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Metadata only. Forbidden in graphDigest."
    },
    "scanId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Opaque local id. Forbidden in graphDigest and default exports if it embeds a path."
    },
    "scope": { "$ref": "#/$defs/ScanScope" },
    "projectContexts": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/ProjectContext" }
    },
    "nodes": {
      "type": "array",
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/FileNode" }
    },
    "observations": {
      "type": "array",
      "maxItems": 50000,
      "items": { "$ref": "#/$defs/ImportObservation" }
    },
    "semanticEdges": {
      "type": "array",
      "maxItems": 25000,
      "items": { "$ref": "#/$defs/SemanticEdge" }
    },
    "coverage": { "$ref": "#/$defs/Coverage" },
    "graphDigest": { "$ref": "#/$defs/Sha256Digest" },
    "contentManifestDigest": { "$ref": "#/$defs/Sha256Digest" }
  },
  "$defs": {
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "RelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*\\x00)(?!.*\\.\\./).+$"
    },
    "NodeId": { "$ref": "#/$defs/RelativePath" },
    "ScanScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repositoryIdentity", "edgePolicy", "limits"],
      "properties": {
        "kind": { "type": "string", "enum": ["working-tree", "imported-snapshot", "git-commit"] },
        "repositoryIdentity": { "type": "string", "minLength": 1, "maxLength": 128 },
        "selectedCommit": { "type": "string", "maxLength": 64 },
        "edgePolicy": { "type": "string", "enum": ["value-and-mixed", "include-type-only"] },
        "exclusionDigest": { "$ref": "#/$defs/Sha256Digest" },
        "limits": { "$ref": "#/$defs/ScanLimits" },
        "truncated": { "type": "boolean" }
      }
    },
    "ScanLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxSourceFiles", "maxBytesPerFile", "maxAnalyzedBytes"],
      "properties": {
        "maxSourceFiles": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "maxBytesPerFile": { "type": "integer", "minimum": 1 },
        "maxAnalyzedBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "ProjectContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "configPath"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "type": "string", "enum": ["tsconfig", "jsconfig", "inferred"] },
        "configPath": { "anyOf": [{ "$ref": "#/$defs/RelativePath" }, { "type": "null" }] },
        "digest": { "$ref": "#/$defs/Sha256Digest" },
        "pathMappings": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "language": {
          "type": "string",
          "enum": ["typescript", "python", "java"],
          "description": "Optional family tag. Omitted on 1.0.0 TypeScript snapshots. typescript covers the TS/JS adapter."
        }
      }
    },
    "FileNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relativePath", "contentHash", "language", "projectContextId", "parseStatus"],
      "properties": {
        "id": { "$ref": "#/$defs/NodeId" },
        "relativePath": { "$ref": "#/$defs/RelativePath" },
        "contentHash": { "$ref": "#/$defs/Sha256Digest" },
        "language": {
          "type": "string",
          "enum": ["ts", "tsx", "js", "jsx", "mts", "cts", "mjs", "cjs", "py", "java"]
        },
        "projectContextId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "parseStatus": { "type": "string", "enum": ["ok", "partial", "failed", "skipped"] }
      }
    },
    "SourceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startOffset", "endOffset", "startLine", "startColumn", "endLine", "endColumn"],
      "properties": {
        "startOffset": { "type": "integer", "minimum": 0 },
        "endOffset": { "type": "integer", "minimum": 0 },
        "startLine": { "type": "integer", "minimum": 1 },
        "startColumn": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 1 }
      }
    },
    "Resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasonCode"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["internal", "external", "excluded", "declaration-only", "unresolved", "unsupported"]
        },
        "targetId": { "$ref": "#/$defs/NodeId" },
        "externalName": { "type": "string", "maxLength": 256 },
        "contextId": { "type": "string", "maxLength": 128 },
        "reasonCode": {
          "type": "string",
          "enum": [
            "RESOLVED_INTERNAL",
            "EXTERNAL_PACKAGE",
            "UNRESOLVED_MODULE",
            "UNSUPPORTED_SYNTAX",
            "OUTSIDE_ROOT",
            "EXCLUDED",
            "DECLARATION_ONLY",
            "CONFIG_OUTSIDE_ROOT",
            "ENCODING_UNSUPPORTED",
            "PARSE_FAILED",
            "LIMIT_HIT",
            "SYMLINK_SKIPPED",
            "ASSET_UNSUPPORTED",
            "PROTOCOL_UNSUPPORTED",
            "NODE_BUILTIN",
            "WORKSPACE_PACKAGE",
            "WILDCARD_IMPORT"
          ]
        }
      }
    },
    "ImportObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "importerId",
        "specifier",
        "syntaxKind",
        "edgeClass",
        "range",
        "resolution"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "importerId": { "$ref": "#/$defs/NodeId" },
        "specifier": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "syntaxKind": {
          "type": "string",
          "enum": [
            "static-import",
            "export-from",
            "type-only-import",
            "type-only-export-from",
            "mixed-import",
            "mixed-export-from",
            "dynamic-import",
            "require",
            "import-equals",
            "triple-slash-path",
            "other-unsupported"
          ]
        },
        "edgeClass": { "type": "string", "enum": ["value", "type", "mixed"] },
        "range": { "$ref": "#/$defs/SourceRange" },
        "resolution": { "$ref": "#/$defs/Resolution" },
        "importedNames": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "sideEffect": { "type": "boolean" }
      }
    },
    "SemanticEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "importerId", "edgeClass", "syntaxClass", "observationIds"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "importerId": { "$ref": "#/$defs/NodeId" },
        "targetId": { "$ref": "#/$defs/NodeId" },
        "unresolvedSpecifier": { "type": "string", "maxLength": 1024 },
        "edgeClass": { "type": "string", "enum": ["value", "type", "mixed"] },
        "syntaxClass": { "type": "string", "enum": ["static-import", "export-from", "mixed"] },
        "observationIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string" }
        },
        "importedNames": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "Coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discoveredFiles",
        "analyzedFiles",
        "skippedFiles",
        "parseFailures",
        "constructCounts",
        "truncations"
      ],
      "properties": {
        "discoveredFiles": { "type": "integer", "minimum": 0 },
        "analyzedFiles": { "type": "integer", "minimum": 0 },
        "skippedFiles": { "type": "integer", "minimum": 0 },
        "parseFailures": { "type": "integer", "minimum": 0 },
        "constructCounts": { "$ref": "#/$defs/ConstructCounts" },
        "truncations": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string" }
        },
        "reusedFiles": { "type": "integer", "minimum": 0 },
        "declaredPackages": {
          "type": "array",
          "maxItems": 512,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "skippedDirectories": { "type": "integer", "minimum": 0 },
        "workspacePackages": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/WorkspacePackage" }
        },
        "elapsedMs": { "type": "integer", "minimum": 0 },
        "resolverCacheHits": { "type": "integer", "minimum": 0 },
        "reusedResolutions": { "type": "integer", "minimum": 0 }
      }
    },
    "WorkspacePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "directory"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "directory": { "$ref": "#/$defs/RelativePath" }
      }
    },
    "ConstructCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internal", "external", "unresolved", "unsupported", "typeOnly", "mixed"],
      "properties": {
        "internal": { "type": "integer", "minimum": 0 },
        "external": { "type": "integer", "minimum": 0 },
        "unresolved": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 },
        "typeOnly": { "type": "integer", "minimum": 0 },
        "mixed": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
